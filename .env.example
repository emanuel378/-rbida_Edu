# Copie este arquivo para .env.local e preencha com os dados do projeto
# Supabase que você quer usar nesta máquina (produção, teste ou
# homologação). O .env.local nunca é commitado (ver .gitignore).
#
# Onde encontrar: Supabase Dashboard > Project Settings > API.
# VITE_SUPABASE_ANON_KEY é a chave "anon / publishable" — segura para
# expor no front-end. Nunca coloque a "service_role" aqui.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
